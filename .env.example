# Optional. If omitted, Property OS creates and stores a local secret in ./data/.
PROPERTY_OS_SECRET=
# Bind to 127.0.0.1 for this computer only. Use 0.0.0.0 for trusted LAN access.
PROPERTY_OS_HOST=127.0.0.1
PROPERTY_OS_PORT=8000

# WhatsApp Cloud API (Meta developer app). Never commit real values.
# Verify token: any long random string you invent; paste the same one into Meta's "Verify token" box.
WHATSAPP_VERIFY_TOKEN=
# App secret: Meta app dashboard > App settings > Basic > App secret. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=c65d4d1bbac3552e190cb52e5a7067050673d50ff01c2497

